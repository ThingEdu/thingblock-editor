{
  "name": "@thingblock/thingblock-vm",
  "version": "14.1.0",
  "description": "Virtual Machine for Scratch 3.0",
  "keywords": [],
  "homepage": "https://github.com/ThingEdu/thingblock-editor#readme",
  "bugs": {
    "url": "https://github.com/ThingEdu/thingblock-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThingEdu/thingblock-editor.git",
    "directory": "packages/thingblock-vm"
  },
  "license": "AGPL-3.0-only",
  "author": "Massachusetts Institute of Technology",
  "exports": {
    ".": {
      "webpack": "./src/index.js",
      "browser": "./dist/web/thingblock-vm.js",
      "node": "./dist/node/thingblock-vm.js",
      "default": "./src/index.js"
    },
    "./src/extension-support/block-type": "./src/extension-support/block-type"
  },
  "main": "./dist/node/thingblock-vm.js",
  "browser": "./dist/web/thingblock-vm.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "TRADEMARK"
  ],
  "scripts": {
    "build": "npm run docs && webpack --progress",
    "clean": "rimraf dist docs/api",
    "coverage": "TS_NODE_PROJECT=$PWD/tsconfig.test.json tap --node-arg=--require=$PWD/test/fixtures/register-asset-require.js ./test/{unit,integration}/*.{js,ts} --coverage --coverage-report=lcov",
    "docs": "typedoc",
    "lint": "eslint",
    "prepublishOnly": "echo \"Please publish through CI only.\" && exit 1",
    "tap": "TS_NODE_PROJECT=$PWD/tsconfig.test.json tap --node-arg=--require=$PWD/test/fixtures/register-asset-require.js ./test/{unit,integration}/*.{js,ts}",
    "tap:integration": "tap --node-arg=--require=$PWD/test/fixtures/register-asset-require.js ./test/integration/*.js",
    "tap:unit": "TS_NODE_PROJECT=$PWD/tsconfig.test.json tap --node-arg=--require=$PWD/test/fixtures/register-asset-require.js ./test/unit/*.{js,ts}",
    "test": "npm run typecheck && npm run lint && npm run tap",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "watch": "webpack --progress --watch"
  },
  "browserslist": [
    "Chrome >= 63",
    "Edge >= 15",
    "Firefox >= 57",
    "Safari >= 11"
  ],
  "tap": {
    "allow-incomplete-coverage": true
  },
  "dependencies": {
    "@thingblock/thingblock-storage": "14.1.0",
    "@vernier/godirect": "1.8.3",
    "arraybuffer-loader": "1.0.8",
    "atob": "2.1.2",
    "btoa": "1.2.1",
    "canvas-toBlob": "1.0.0",
    "decode-html": "2.0.0",
    "esptool-js": "^0.6.0",
    "format-message": "6.2.4",
    "htmlparser2": "3.10.1",
    "immutable": "3.8.3",
    "jszip": "3.10.1",
    "scratch-parser": "6.0.0",
    "scratch-translate-extension-languages": "1.0.7",
    "text-encoding": "0.7.0",
    "tslog": "4.10.2",
    "uuid": "8.3.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "adm-zip": "0.4.11",
    "babel-loader": "9.2.1",
    "callsite": "1.0.0",
    "docdash": "1.2.0",
    "eslint": "9.39.4",
    "eslint-config-scratch": "14.1.30",
    "expose-loader": "1.0.3",
    "file-loader": "6.2.0",
    "globals": "16.5.0",
    "in-publish": "2.0.1",
    "js-md5": "0.7.3",
    "pngjs": "3.4.0",
    "scratch-webpack-configuration": "3.1.2",
    "tap": "21.7.4",
    "tiny-worker": "2.3.0",
    "ts-loader": "9.6.0",
    "typedoc": "0.28.18",
    "typescript": "5.9.3",
    "webpack": "5.107.2",
    "webpack-cli": "4.10.0"
  }
}
