    "preview": "vite preview",
    "test": "npm run lint && tsc && vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.187.0",
    "eslint": "9.39.4",
    "eslint-config-scratch": "14.1.30",
    "postcss-import": "17.0.1",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.8.4",
    "rimraf": "6.1.2",
    "typescript": "5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "@thingblock/thingblock-ui": "0.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.187.0"
  }
