{
  "name": "thingblock-editor",
  "version": "14.1.0",
  "private": "true",
  "description": "ThingBlock editor mono-repository",
  "keywords": [],
  "homepage": "https://github.com/ThingEdu/thingblock-editor#readme",
  "bugs": {
    "url": "https://github.com/ThingEdu/thingblock-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThingEdu/thingblock-editor.git"
  },
  "license": "MIT",
  "author": "ThingEdu",
  "workspaces": [
    "packages/thingblock-blocks",
    "packages/task-herder",
    "packages/thingblock-storage",
    "packages/thingblock-vm",
    "packages/thingblock-gui",
    "packages/thingblock-resource"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production npm run --workspaces build",
    "build:libs": "cross-env NODE_ENV=production npm run build --workspace=@scratch/task-herder --workspace=@thingblock/thingblock-blocks --workspace=@thingblock/thingblock-storage --workspace=@thingblock/thingblock-vm",
    "clean": "npm run --workspaces clean",
    "prepare": "husky install",
    "refresh-gh-workflow": "ts-node scripts/update-gha-workflows.ts",
    "start": "npm --workspace @thingblock/thingblock-gui start",
    "test": "npm test --workspaces",
    "update-legal": "scripts/update-legal.sh",
    "version": "cross-env-shell ./scripts/npm-version.sh"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "17.8.1",
    "@commitlint/config-conventional": "17.8.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "conventional-changelog-angular": "8.3.1",
    "cross-env": "7.0.3",
    "globals": "16.5.0",
    "husky": "8.0.3",
    "npm": "11.18.0",
    "semantic-release": "25.0.5",
    "ts-node": "10.9.2"
  }
}
